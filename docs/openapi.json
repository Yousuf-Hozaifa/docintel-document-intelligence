       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Customer"
      }
     },
     {
      "name": "currency",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
