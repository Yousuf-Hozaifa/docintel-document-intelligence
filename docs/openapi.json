  "/api/search/semantic": {
   "get": {
    "summary": "Semantic Search",
    "description": "mode=semantic ranks documents by meaning (best-matching chunk; score = cosine similarity). mode=hybrid (default) fuses\nthat ranking with keyword matches (reciprocal-rank fusion; score = fused rank score). Filters apply after ranking.\nRely on the order, not on absolute score values.",
    "operationId": "semantic_search_api_search_semantic_get",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "minLength": 1,
       "maxLength": 500,
       "title": "Q"
      }
     },
     {
      "name": "supplier",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Supplier"
      }
     },
     {
